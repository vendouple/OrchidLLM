<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - OrchidLLM</title>
    @* Minimal fallback shell — only the Error page uses this layout. The real pages
       (login, admin, dashboard) each carry their own M3E-styled layouts. *@
    <style>
        body { font-family: system-ui, sans-serif; background: #141218; color: #e6e0e9; margin: 0; }
        main { max-width: 640px; margin: 10vh auto; padding: 0 24px; }
        a { color: #cbc3ff; }
        code { background: #211f26; padding: 2px 6px; border-radius: 6px; }
    </style>
</head>
<body>
    <main role="main">
        @RenderBody()
    </main>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
