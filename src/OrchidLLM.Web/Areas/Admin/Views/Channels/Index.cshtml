@using System.Text.Json
@model List<OrchidLLM.Web.Areas.Admin.Controllers.ChannelsController.ChannelRow>
@{
    ViewData["Title"] = "Channels";
    ViewData["ActiveSection"] = "providers";
}

<section class="admin-section active" id="section-providers">
    <div class="channels-policy">
        <div class="cp-item">
            <span class="material-symbols-outlined">dns</span>
            <div>
                <div class="cp-label">Headline metric</div>
                <div class="cp-val">RPM (live, 60s window) — replaces the old raw concurrency stat</div>
            </div>
        </div>
        <div class="cp-item">
            <span class="material-symbols-outlined">key</span>
            <div>
                <div class="cp-label">Provider API keys</div>
                <div class="cp-val">Stored encrypted at rest (AES-256-GCM) via this Channels UI — no longer .env-only</div>
            </div>
        </div>
    </div>

    @if (TempData["ProbeResult"] is string probeMsg)
    {
        <p class="hint">@probeMsg</p>
    }

    <div style="margin:16px 0;">
        <a class="oauth-btn" href="/Admin/Channels/Edit" style="display:inline-flex;width:auto;padding:8px 16px;">
            <span class="material-symbols-outlined" style="font-size:18px;">add</span>
            <span>Add Channel</span>
        </a>
    </div>

    <div class="provider-grid" id="provider-grid">
        @if (!Model.Any())
        {
            <p class="hint">No channels configured yet. Add one to start routing real requests.</p>
        }
        @foreach (var row in Model)
        {
            var p = row.Provider;
            var hasIssue = p.Status is "dead" or "out_of_credits";
            var rpmDisplay = p.RpmCap.HasValue ? $"{row.CurrentRpm}<small>/{p.RpmCap} cap</small>" : $"{row.CurrentRpm}<small> rpm</small>";
            var modalities = string.IsNullOrWhiteSpace(p.Modalities)
                ? new Dictionary<string, List<string>>()
                : (JsonSerializer.Deserialize<Dictionary<string, List<string>>>(p.Modalities) ?? new());
            <div class="provider-card @(hasIssue ? "has-issue" : "")">
                <div class="pc-head">
                    <div class="pc-glyph">@p.Name.Substring(0, 1)</div>
                    <div>
                        <div class="pc-title">@p.Name</div>
                        <div class="pc-url">@p.BaseUrl</div>
                    </div>
                    <div class="pc-head-right"><span class="status-chip st-@p.Status">@p.Status.Replace("_", " ")</span></div>
                </div>
                <div class="pc-metrics">
                    <div class="pc-metric">
                        <div class="pc-metric-label">Weight</div>
                        <div class="pc-metric-value">@p.Weight <small>lower = better</small></div>
                    </div>
                    <div class="pc-metric">
                        <div class="pc-metric-label">RPM</div>
                        <div class="pc-metric-value">@Html.Raw(rpmDisplay)</div>
                    </div>
                    <div class="pc-metric">
                        <div class="pc-metric-label">Concurrency cap</div>
                        <div class="pc-metric-value"><small>@p.MaxConcurrent max (safety limit only)</small></div>
                    </div>
                    <div class="pc-metric">
                        <div class="pc-metric-label">Free tier</div>
                        <div class="pc-metric-value" style="color:@(p.Free ? "var(--st-active)" : "var(--md-sys-color-outline)")">@(p.Free ? "Yes" : "No")</div>
                    </div>
                </div>
                <div class="pc-modalities">
                    <div class="pc-keys-head" style="margin-bottom:6px"><span>Modality support</span></div>
                    @if (!modalities.Any())
                    {
                        <div class="hint" style="margin:0">No modalities configured</div>
                    }
                    else
                    {
                        foreach (var (mod, parms) in modalities)
                        {
                            <div class="pc-mod-row"><span class="pc-mod-name">@mod</span><span class="pc-mod-params">@(parms.Any() ? string.Join(", ", parms) : "no params")</span></div>
                        }
                    }
                </div>
                <div>
                    <div class="pc-keys-head">
                        <span>Key pool (@p.Keys.Count) — LRU rotation</span>
                    </div>
                    <div class="pc-key-list" style="margin-top:8px">
                        @foreach (var k in p.Keys)
                        {
                            <div class="pc-key-row">
                                <span class="key-dot k-@k.Status"></span>
                                <span class="pc-key-preview">@k.KeyPreview</span>
                                <span class="key-status-label k-@k.Status">@k.Status.Replace("_", " ")</span>
                                <form method="post" action="/Admin/Channels/DeleteKey" onsubmit="return confirm('Revoke this key?');" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="providerId" value="@p.Id" />
                                    <input type="hidden" name="keyId" value="@k.Id" />
                                    <button type="submit" class="icon-btn danger" title="Revoke key" style="width:28px;height:28px;background:none;border:none;cursor:pointer;">
                                        <span class="material-symbols-outlined" style="font-size:16px">delete</span>
                                    </button>
                                </form>
                            </div>
                        }
                    </div>
                </div>
                <div class="pc-actions">
                    <form method="post" action="/Admin/Channels/Probe" style="display:inline;">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@p.Id" />
                        <button type="submit" class="icon-btn" title="Probe" style="background:none;border:none;cursor:pointer;">
                            <span class="material-symbols-outlined" style="font-size:16px">ecg_heart</span> Probe
                        </button>
                    </form>
                    <a class="icon-btn" href="/Admin/Channels/Edit/@p.Id" title="Edit">
                        <span class="material-symbols-outlined" style="font-size:16px">edit</span> Edit
                    </a>
                    <form method="post" action="/Admin/Channels/Delete/@p.Id" onsubmit="return confirm('Remove this channel?');" style="display:inline;">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="icon-btn danger" title="Delete" style="background:none;border:none;cursor:pointer;">
                            <span class="material-symbols-outlined" style="font-size:16px">delete</span> Delete
                        </button>
                    </form>
                </div>
            </div>
        }
    </div>
</section>
