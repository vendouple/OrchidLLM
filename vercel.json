{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "*.css",
      "use": "@vercel/static"
    },
    {
      "src": "*.js",
      "use": "@vercel/static"
    },
    {
      "src": "*.json",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/api/v1/models/([^/]+)", "dest": "/api/v1/models.js?model_id=$1" },
    { "src": "/api/v1/(.*)", "dest": "/api/v1/$1.js" },
    { "src": "/api/auth/(.*)", "dest": "/api/auth/$1.js" },
    { "src": "/api/admin/(.*)", "dest": "/api/admin/$1.js" },
    { "src": "/api/user/(.*)", "dest": "/api/user/$1.js" },
    { "src": "/api/demo/(.*)", "dest": "/api/demo/$1.js" },
    { "src": "/api/cron/(.*)", "dest": "/api/cron/$1.js" },
    { "src": "/api/models", "dest": "/api/models.js" },
    { "src": "/api/chat/completions", "dest": "/api/chat/completions.js" },
    { "src": "/api/images/generations", "dest": "/api/images/generations.js" },
    { "src": "/api/audio/speech", "dest": "/api/audio/speech.js" },
    { "src": "/api/audio/transcriptions", "dest": "/api/audio/transcriptions.js" },
    { "src": "/api/video/generations", "dest": "/api/video/generations.js" },
    { "src": "/(.*)", "dest": "/$1" }
  ],
  "crons": [
    {
      "path": "/api/cron/queue-worker",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/cleanup-demo",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/rollover",
      "schedule": "0 4 * * *"
    }
  ]
}
