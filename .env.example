# ── Demo Limits ───────────────────────────────────────────────
# These override system_settings DB values if set.
# DEMO_REQUESTS_PER_DAY=20
# DEMO_CONTEXT_CAP=33000

# ── CORS ──────────────────────────────────────────────────────
# Production credentialed CORS is allowlist-only.
# ALLOWED_ORIGINS=https://orchidllm.vercel.app,https://www.orchidllm.com
# APP_URL=https://orchidllm.vercel.app

# ── Redis ─────────────────────────────────────────────────────
# Production protected rate-limit paths require durable Upstash Redis.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ── Provider calls ────────────────────────────────────────────
# PROVIDER_TIMEOUT_MS=60000

# ── Queue ─────────────────────────────────────────────────────
# QUEUE_STALE_SECONDS=120
# QUEUE_WAIT_TIMEOUT_MS=25000
# QUEUE_POLL_MS=500

# ── Vercel ────────────────────────────────────────────────────
# Auto-set by Vercel — do not set manually.
# VERCEL_URL=orchidllm.vercel.app

# Optional: override auto-detected base URL for OAuth callbacks and CORS allowlist
# BASE_URL=https://orchidllm.vercel.app
# API_BASE_URL=https://orchidllm.vercel.app/api

# ── Cron ──────────────────────────────────────────────────────
# Production cron handlers require this and fail closed if missing.
# CRON_SECRET=replace_with_a_secure_random_string
