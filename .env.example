# ─────────────────────────────────────────────────────────────
# OrchidLLM Environment Variables — v3.0
# Copy to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# ── Oracle Cloud ADB ─────────────────────────────────────────
ORACLE_DB_USER=ADMIN
ORACLE_DB_PASSWORD=your_password_here
ORACLE_DB_CONNECTION_STRING=(description=(retry_count=1)(retry_delay=1)(address=(protocol=tcps)(port=1521)(host=adb.ap-singapore-1.oraclecloud.com))(connect_data=(service_name=YOUR_SERVICE_NAME.adb.oraclecloud.com))(security=(ssl_server_dn_match=yes)))

# Pool tuning (optional)
# ORACLE_DB_POOL_MIN=1
# ORACLE_DB_POOL_MAX=4
# ORACLE_DB_CALL_TIMEOUT=10000

# ── GitHub OAuth ─────────────────────────────────────────────
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# ── Session ──────────────────────────────────────────────────
# Production requires this. Use a long random string (32+ chars).
# Rotating it invalidates existing stateless session cookies.
SESSION_SECRET=replace_with_a_secure_random_string

# ── Admin Access ─────────────────────────────────────────────
# Production requires an explicit comma-separated GitHub username allowlist.
# There is no production hardcoded admin fallback.
ADMIN_GITHUB_HANDLES=vendouple

# ── Provider API Keys ─────────────────────────────────────────
# These env var names are referenced in the providers.auth_key_env DB column.
# Add a provider row in DB with auth_key_env = 'NVIDIA_API_KEY', etc.
# For each provider, set <PROVIDER_ENV_VAR>_SPEED to a numeric speed rating.
# Higher number = faster provider. Paid traffic prefers higher values; free/demo traffic can use lower values first.
POLLINATIONS_API_KEY=
POLLINATIONS_API_KEY_SPEED=
NVIDIA_API_KEY=
NVIDIA_API_KEY_SPEED=
MISTRAL_API_KEY=
MISTRAL_API_KEY_SPEED=
CEREBRAS_API_KEY=
CEREBRAS_API_KEY_SPEED=
VOIDAI_API_KEY=
VOIDAI_API_KEY_SPEED=
NAVY_API_KEY=
NAVY_API_KEY_SPEED=
OLLAMA=
OLLAMA_SPEED=
PAXSENIX=
PAXSENIX_SPEED=
AIHUBMIX=
AIHUBMIX_SPEED=
LITE_ROUTER=
LITE_ROUTER_SPEED=
CLOUDFLARE=
CLOUDFLARE_SPEED=
AQUADEVS=
AQUADEVS_SPEED=
GROQ_API_KEY=
GROQ_API_KEY_SPEED=
GOOGLE_AI_STUDIO_API_KEY=
