# ----------------------------------------------------
# Provider Attributes (Speed Tier & Free Tier logic)
# ----------------------------------------------------
# SPEED TIERS: 1 = Ultra Fast, 2 = Fast, 3 = Standard, 4 = Slow, 5 = Ultra Slow
# You can set custom speed tiers and free-tier access here (defaults to 3 and false)
#
# PROVIDER_POLLINATIONS_SPEED_TIER=3
# PROVIDER_POLLINATIONS_ENABLE_FREE_TIER=true
# 
# PROVIDER_NVIDIA_SPEED_TIER=1
# PROVIDER_NVIDIA_ENABLE_FREE_TIER=false
#
# PROVIDER_MISTRAL_SPEED_TIER=2
# PROVIDER_MISTRAL_ENABLE_FREE_TIER=false
#
# PROVIDER_CEREBRAS_SPEED_TIER=1
# PROVIDER_CEREBRAS_ENABLE_FREE_TIER=false
#
# PROVIDER_VOIDAI_SPEED_TIER=3
# PROVIDER_VOIDAI_ENABLE_FREE_TIER=false
#
# PROVIDER_CLOUDFLARE_SPEED_TIER=2
# PROVIDER_CLOUDFLARE_ENABLE_FREE_TIER=true
#
# PROVIDER_NAVY_SPEED_TIER=3
# PROVIDER_NAVY_ENABLE_FREE_TIER=false
#
# PROVIDER_OLLAMA_SPEED_TIER=4
# PROVIDER_OLLAMA_ENABLE_FREE_TIER=true

